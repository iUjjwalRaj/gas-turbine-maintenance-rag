# Gas Turbine Maintenance Assistant Configuration

# Document and Storage Paths
PDF_PATH=data/GER-3620-P.pdf
CHROMA_PERSIST_DIR=chroma_db
COLLECTION_NAME=gas_turbine_maintenance

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Embedding Configuration (Local sentence-transformers model)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval Configuration
TOP_K=4
MAX_COSINE_DISTANCE=1.05

# Google Gemini Generative LLM Configuration
# Set your Gemini API key below to enable Gemini-powered concise answer synthesis.
# Leave GEMINI_API_KEY empty to use the built-in offline extractive RAG engine.
USE_GEMINI=true
GEMINI_API_KEY=
# Gemini Flash model identifier (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
