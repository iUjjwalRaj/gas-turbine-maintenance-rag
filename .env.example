# Gas Turbine Maintenance Assistant Configuration

# Document and Storage Paths
PDF_PATH=data/GER-3620-P.pdf
CHROMA_PERSIST_DIR=chroma_db
COLLECTION_NAME=gas_turbine_maintenance

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Embedding Configuration (Local sentence-transformers model)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval Configuration
TOP_K=4
MAX_COSINE_DISTANCE=1.05

# Optional Generative LLM Configuration (Default is offline extractive RAG)
# If USE_LLM=true and OPENAI_API_KEY is provided, answers are synthesized with strict evidence grounding.
USE_LLM=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
